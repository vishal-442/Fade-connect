# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local:   mongodb://127.0.0.1:27017/fade-connect
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fade-connect
MONGO_URI=mongodb://127.0.0.1:27017/fade-connect

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ---- Cloudinary (image uploads) ----
# Leave blank to fall back to local disk storage under /uploads (dev only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (payments) ----
# Leave blank + MOCK_PAYMENTS=true to auto-simulate successful payments in dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MOCK_PAYMENTS=true

# ---- Google Maps ----
# Used by the client (Vite) - see client/.env.example
GOOGLE_MAPS_API_KEY=

# ---- Email (Nodemailer) ----
# Leave blank to fall back to logging emails to the console in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fade Connect <no-reply@fadeconnect.app>"
