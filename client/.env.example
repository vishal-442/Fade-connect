# Base URL for API calls. Leave as /api to use the Vite dev proxy to the
# backend (see vite.config.js). Set to a full URL (e.g. https://api.yourapp.com/api)
# when the frontend and backend are deployed separately.
VITE_API_URL=/api

# Google Maps JavaScript API key - used to render the salon location map.
# Without it, the app falls back to a static address card + "Open in Maps" link.
VITE_GOOGLE_MAPS_API_KEY=
